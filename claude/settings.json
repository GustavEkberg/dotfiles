{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "disableClaudeAiConnectors": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ]; then sh \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "dark-daltonized"
}
